{
  "name": "qypher-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite . --host 127.0.0.1 --port 4173 --strictPort",
