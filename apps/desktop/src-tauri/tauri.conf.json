{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qypher",
  "version": "0.1.5",
  "identifier": "org.qypher.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "decorations": false,
        "title": "Qypher — Segurança de aplicações",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#07070B"
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1NkNEOEFDQUIzMTY4MUUKUldRZWFER3JyTmhzQlRxT1dZdU0vVTFXL2VORlp1OVQ5bzZDZ0ZFV0tPTEsxSkdiNUw5RE1hUG4K",
      "endpoints": ["https://github.com/PQueirozDev/qypher/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "PQueirozDev",
    "copyright": "Copyright © 2026 PQueirozDev. Apache-2.0.",
    "homepage": "https://github.com/PQueirozDev/qypher",
    "shortDescription": "Local-first security audits for the web",
    "longDescription": "Qypher audita, localmente, sites autorizados e código-fonte em busca de arquivos expostos, falhas de configuração e credenciais vazadas, explicando o risco e como corrigir.",
    "category": "DeveloperTool",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "startMenuFolder": "Qypher",
        "installerHooks": "./installer-hooks.nsh",
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
